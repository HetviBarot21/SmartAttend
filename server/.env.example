AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
ATTENDANCE_TABLE=attendance-events
AUDIT_TABLE=audit-log
RISK_SCORES_TABLE=risk-scores
S3_BUCKET=smartattend-models
JWT_SECRET=smartattend_secret_key_2026
PORT=3000

# --- Local SQLite -----------------------------------------------------------
SQLITE_PATH=./data/smartattend.db

# --- Outbound cloud sync (syncWorker.js) -----------------------------------
# API Gateway invoke URL for the sync Lambda. While there is no real AWS, point
# this at a local shim that invokes aws/lambda/syncHandler.js (e.g. sam local
# start-api, or a small Express wrapper). Swap in the real invoke URL later.
SYNC_API_GATEWAY_URL=http://localhost:4000/sync
SYNC_API_GATEWAY_KEY=placeholder
SYNC_POLL_INTERVAL_MS=30000
SYNC_BATCH_SIZE=50
SYNC_BACKOFF_MIN_MS=60000
SYNC_BACKOFF_MAX_MS=1800000
SYNC_MAX_ATTEMPTS=12
SYNC_REQUEST_TIMEOUT_MS=15000
SYNC_DEVICE_ID=tier2-server
# SYNC_WORKER_DISABLED=true   # set to skip spawning the worker (e.g. in tests)

# --- DynamoDB (Lambdas) ---------------------------------------------------
# Used only when AWS_ACCESS_KEY_ID is unset/"placeholder": target DynamoDB Local.
#   docker run -p 8000:8000 amazon/dynamodb-local
# Remove this line once real AWS credentials / an execution role are in place.
DYNAMODB_ENDPOINT=http://localhost:8000

# --- Africa's Talking (SMS, notificationHandler.js) ----------------------
AT_USERNAME=sandbox
AT_API_KEY=placeholder
AT_SENDER_ID=SMARTATTEND
AT_API_URL=https://api.sandbox.africastalking.com/version1/messaging
# Production: AT_USERNAME=<your app>, AT_API_KEY=<live key>,
#             AT_API_URL=https://api.africastalking.com/version1/messaging

# --- AWS SES (email, notificationHandler.js) -----------------------------
# SES is not offered in af-south-1 - use a supported region.
SES_REGION=eu-west-1
SES_FROM_ADDRESS=alerts@smartattend.example
# NOTIFY_DRY_RUN=true   # log SMS/email instead of sending (auto-on with placeholder creds)
# NOTIFY_RESEND=true    # re-notify students already stamped notifiedAt
