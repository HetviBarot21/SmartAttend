# Copy to .env to override. All optional - defaults are in src/config.js.
PORT=3000

# Where the SQLite file lives. Default: %LOCALAPPDATA%\smartattend\smartattend.db
# (deliberately OUTSIDE this repo - OneDrive locks WAL files and stalls SQLite).
# Only set this to a path inside the repo if your checkout is NOT under OneDrive.
# DB_PATH=./data/smartattend.db
# DB_PATH=:memory:

RFID_INTERVAL_MS=5000
FINGERPRINT_CHALLENGE_RATE=0.25
FINGERPRINT_SUCCESS_RATE=0.9
SIMULATION_ENABLED=true

# --- Outbound cloud sync (src/workers/syncWorker.js) -----------------------
# API Gateway invoke URL for the sync Lambda. With no real AWS yet, point this
# at a local shim that invokes aws/lambda/syncHandler.js (sam local start-api,
# or a small Express wrapper). Swap in the real invoke URL + key later.
SYNC_API_GATEWAY_URL=http://localhost:4000/sync
SYNC_API_GATEWAY_KEY=placeholder
SYNC_POLL_INTERVAL_MS=30000
SYNC_BATCH_SIZE=50
SYNC_BACKOFF_MIN_MS=60000
SYNC_BACKOFF_MAX_MS=1800000
SYNC_MAX_ATTEMPTS=12
SYNC_REQUEST_TIMEOUT_MS=15000
SYNC_DEVICE_ID=tier2-server
# SYNC_WORKER_DISABLED=true   # skip spawning the worker (e.g. in tests)

# The Lambdas themselves (aws/) read their own AWS / DynamoDB / Africa's Talking
# / SES config - see aws/ for that. This server only needs the SYNC_* vars above.
